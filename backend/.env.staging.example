# Copia como .env.staging. Usa credenciales y recursos distintos de producción.
DB_PASSWORD=replace-with-a-staging-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=https://staging-app.example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_FILE=

DIRECTIONS_ENABLED=false
DIRECTIONS_API_KEY=

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=staging-no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

SWAGGER_ENABLED=false
