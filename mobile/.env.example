# Copia este archivo a ".env" y completa los valores reales.
# Expo expone automáticamente las variables con prefijo EXPO_PUBLIC_ al cliente.

# URL base del backend (incluye /api)
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Google Maps SDK / Directions API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# ID asignado por EAS al ejecutar "eas init"; habilita tokens push de Expo.
EXPO_PUBLIC_EAS_PROJECT_ID=

# URLs públicas obligatorias antes de publicar en tiendas.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
